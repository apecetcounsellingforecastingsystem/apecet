# Copy this file to .env and fill real values, then:
#   export $(grep -v '^#' .env | xargs)
#   export OTP_DEMO_MODE=0
#   python app.py

OTP_DEMO_MODE=0
SECRET_KEY=change-this-to-a-long-random-string

# ========== EMAIL OTP (Gmail App Password) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=yourgmail@gmail.com
SMTP_USE_TLS=1

# ========== SMS OTP — pick ONE provider ==========
SMS_PROVIDER=fast2sms

# Option A: Fast2SMS (https://www.fast2sms.com → Dev API)
FAST2SMS_API_KEY=your_fast2sms_authorization_key
FAST2SMS_ROUTE=q

# Option B: MSG91 (https://msg91.com)
# MSG91_AUTH_KEY=your_msg91_authkey
# MSG91_TEMPLATE_ID=your_dlt_template_id
# MSG91_SENDER_ID=APECET

# Option C: Twilio
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_FROM_NUMBER=+1xxxx
